AGENT_BACKEND=dsh
DEEPSEEK_API_KEY=

# 普通 API 地址用于评分、投票、总结和配置助手。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DSH_BASE_URL=https://api.deepseek.com/anthropic
DSH_BIN=
DSH_MODEL=deepseek-v4-flash
DSH_REASONING_EFFORT=
DSH_REQUEST_MAX_TOKENS=8192
DSH_TURN_MAX_TOKENS=24000
DSH_MAX_STEPS=100
DSH_MAX_TOOL_CALLS=100
DSH_TURN_TIMEOUT=240
DSH_TOOLS=web_search,web_fetch,read,glob,grep,write,edit,pwsh,bash

# 当前辅助调用直连 DeepSeek API，不经过 DSH。密钥和模型自动复用。
LLM_BASE_URL=${DEEPSEEK_BASE_URL}
LLM_API_KEY=${DEEPSEEK_API_KEY}
LLM_MODEL=${DSH_MODEL}
LLM_MOCK=false
LLM_TEMPERATURE=0.8
LLM_SCORE_TEMPERATURE=0.0
LLM_SCORE_MAX_TOKENS=512
LLM_TIMEOUT=120

HOST=127.0.0.1
PORT=5000

# 如果改用 SDK 配套 0.1.5 运行时，必须同时留空 DSH_BIN 和 DSH_BASE_URL。
