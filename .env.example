# OpenAI-compatible LLM endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# Set LLM_MOCK=true to run without a real LLM (useful for local UI testing)
LLM_MOCK=false

# Optional tuning
LLM_TEMPERATURE=0.8
LLM_SCORE_TEMPERATURE=0.0
LLM_SCORE_MAX_TOKENS=512
LLM_TIMEOUT=120

# Web server
HOST=127.0.0.1
PORT=5000
