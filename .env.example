# 讨论角色：dsh 使用工具；direct 使用原来的单次模型调用。
AGENT_BACKEND=dsh

# dsh 的 DeepSeek API（与下面的辅助调用独立；凭据只留在本机环境）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DSH 独立地址：配套 0.1.5 SDK 运行时可留空，继承上面的 Chat Completions 地址。
# 使用本机 0.1.7+ DSH 时填写 https://api.deepseek.com/anthropic（Messages 协议）。
DSH_BASE_URL=
DSH_MODEL=deepseek-v4-flash
# 留空使用 Python SDK 配套运行时；也可填已有兼容 dsh 可执行文件的绝对路径。
DSH_BIN=
DSH_REASONING_EFFORT=
DSH_REQUEST_MAX_TOKENS=8192
DSH_TURN_MAX_TOKENS=24000
DSH_MAX_STEPS=8
DSH_MAX_TOOL_CALLS=12
DSH_TURN_TIMEOUT=180
DSH_TOOLS=web_search,web_fetch,read,glob,grep,write,edit,pwsh,bash

# 最终回复格式错误时才调用 JSON mode；使用同一 DeepSeek 密钥与 DSH_MODEL。
# 这里必须是 Chat Completions 地址，不能带 /anthropic；留空沿用 DEEPSEEK_BASE_URL。
DSH_JSON_BASE_URL=${DEEPSEEK_BASE_URL}
# 0 关闭，1–2 为最多修正次数；成功后立即停止。
DSH_JSON_REPAIR_ATTEMPTS=2
DSH_JSON_REPAIR_MAX_TOKENS=8192

# 评分、投票、总结和配置助手直连 DeepSeek 的 OpenAI 兼容接口。
# 不要将这里的地址改成 /anthropic；两种协议的地址不同。
LLM_BASE_URL=${DEEPSEEK_BASE_URL}
LLM_API_KEY=${DEEPSEEK_API_KEY}
LLM_MODEL=${DSH_MODEL}

# Set LLM_MOCK=true to run without a real LLM (useful for local UI testing)
LLM_MOCK=false

# Optional tuning
LLM_TEMPERATURE=0.8
LLM_SCORE_TEMPERATURE=0.0
LLM_SCORE_MAX_TOKENS=512
LLM_TIMEOUT=120

# Web server
HOST=127.0.0.1
PORT=5000
